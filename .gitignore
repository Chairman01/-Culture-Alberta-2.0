# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large data files (generated at build time from Supabase)
articles.json
lib/data/articles.json
.vercel

# next-sitemap postbuild artifacts.
# These MUST NOT be committed: a static public/sitemap.xml or public/robots.txt
# collides with the dynamic app/sitemap.ts and app/robots.ts routes, and Next.js
# then serves a 500 ("conflicting public file and page file") for both — which
# would hide the whole site from search engines.
public/robots.txt
public/sitemap.xml
public/sitemap-*.xml
